---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="topbar">
  <div class="topbar-left">
    <button
      class="hamburger"
      id="hamburgerBtn"
      aria-label="Abrir menú"
      aria-expanded="false">☰</button
    >
    <div class="breadcrumb">Manual SIU DIAGUITA <span>/ {title}</span></div>
  </div>
  <div class="topbar-right">
    <button id="darkModeBtn" type="button">Modo oscuro</button>
  </div>
</header>
