---
import Sidebar from "../components/Sidebar.astro";
import Topbar from "../components/Topbar.astro";

interface SectionLink {
  href: string;
  label: string;
}

interface Props {
  title: string;
  currentPath?: string;
  sections?: SectionLink[];
}

const { title, currentPath = "/", sections = [] } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Manual de usuario del sistema institucional SIU Diaguita."
    />
    <title>{title} — Manual SIU DIAGUITA</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/CSS/styles.css" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css"
    />
  </head>
  <body>
    <div id="progress-bar"></div>
    <div class="sidebar-overlay"></div>

    <div class="layout">
      <Sidebar currentPath={currentPath} sections={sections} />

      <div class="main-content">
        <Topbar title={title} />

        <main class="content-area">
          <slot />
        </main>
      </div>
    </div>

    <button id="scrollTopBtn" aria-label="Volver al inicio">↑</button>

    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"
    ></script>
    <script is:inline src="/JavaScript/javascript.js"></script>
  </body>
</html>
