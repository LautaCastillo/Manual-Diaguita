    <div class="footer-bottom">
      <p>
        © 2026 <a href="https://www.unsa.edu.ar" target="_blank"
          >Universidad Nacional de Salta</a
        > · Dirección de Patrimonio · Todos los derechos reservados
      </p>
      <span>Manual Oficial · SIU DIAGUITA</span>
    </div>
  </footer>
</Layout>
