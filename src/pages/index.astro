---
import Layout from "../layouts/Layout.astro";

const recursos = {
  extension: {
    visible: true,
    href: "#",
    label: "Descargar v1.13.93.109",
    badge: "dl",
  },
  diaguita: {
    visible: true,
    href: "http://diaguitadev.unsa.edu.ar/diaguita/",
    label: "Abrir sistema",
    badge: "ex",
  },
  intranet: { visible: true, href: "#", label: "Ir a Intranet", badge: "ex" },
};
---

<Layout title="Inicio" currentPath="/" fullWidth={true}>
  <!-- HERO -->
  <div class="home-hero">
    <div class="hero-inner">
      <div class="hero-logo-box">
        <img
          class="hero-logo"
          src="/Imagenes/0.logo-unsa.png"
          alt="Logo UNSa"
        />
      </div>
      <div class="hero-body">
        <div class="hero-eyebrow">
          Universidad Nacional de Salta · Dirección General de Administración
        </div>
        <h1>Dirección de Patrimonio</h1>
        <p class="hero-sub">Manual de Usuario — SIU Diaguita</p>
        <p>
          Procedimientos oficiales para el registro, transferencia y control de
          bienes patrimoniales institucionales mediante el sistema SIU DIAGUITA
          y su extensión asistida.
        </p>
        <div class="hero-chips">
          <a class="hero-chip" href="https://dga.unsa.edu.ar/" target="_blank"
            >🏛️ Dirección Patrimonio</a
          >
          <a
            class="hero-chip"
            href="https://dga.unsa.edu.ar/docvs/patrimonio/intranet/centro_diaguita/#extension"
            target="_blank">🔌 Extensión vigente</a
          >
          <a
            class="hero-chip"
            href="http://diaguitadev.unsa.edu.ar/diaguita/"
            target="_blank">📋 SIU Diaguita Desarrollo</a
          >
        </div>
      </div>
    </div>
  </div>

  <!-- AVISO -->
  <div class="home-notice">
    <span>⚠️</span>
    <span
      ><strong>Antes de iniciar:</strong> usá siempre <strong
        >SIU-Diaguita Producción</strong
      > para operaciones reales. Reservá <em>Desarrollo</em> para prácticas. Reuní
      la documentación respaldatoria antes de comenzar cualquier trámite.</span
    >
  </div>

  <!-- ACCESO RÁPIDO -->
  <div class="home-section">
    <div class="home-section-hd">
      <h2>¿Qué necesitás hacer hoy?</h2>
      <p>Accedé directamente a la operación que necesitás registrar</p>
    </div>
    <div class="quick-grid">
      <a href="/altas" class="quick-card" data-aos="fade-up" data-aos-delay="0">
        <div class="quick-icon blue">
          <svg
            width="19"
            height="19"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <line x1="12" y1="5" x2="12" y2="19"></line><line
              x1="5"
              y1="12"
              x2="19"
              y2="12"></line>
          </svg>
        </div>
        <h3>Alta de bienes</h3>
        <p>Registrar un bien nuevo en el inventario patrimonial</p>
        <span class="card-link">Ir a Altas →</span>
      </a>
      <a
        href="/transferencias"
        class="quick-card"
        data-aos="fade-up"
        data-aos-delay="80"
      >
        <div class="quick-icon amber">
          <svg
            width="19"
            height="19"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <polyline points="17 1 21 5 17 9"></polyline>
            <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
            <polyline points="7 23 3 19 7 15"></polyline>
            <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
          </svg>
        </div>
        <h3>Transferencia</h3>
        <p>Mover un bien entre sectores o unidades de la institución</p>
        <span class="card-link">Ir a Transferencias →</span>
      </a>
      <a
        href="/reasignaciones"
        class="quick-card"
        data-aos="fade-up"
        data-aos-delay="160"
      >
        <div class="quick-icon teal">
          <svg
            width="19"
            height="19"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </div>
        <h3>Reasignación</h3>
        <p>Cambiar el responsable de uso de un bien patrimonial</p>
        <span class="card-link">Ir a Reasignaciones →</span>
      </a>
      <a
        href="/bajas"
        class="quick-card"
        data-aos="fade-up"
        data-aos-delay="240"
      >
        <div class="quick-icon red">
          <svg
            width="19"
            height="19"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <polyline points="3 6 5 6 21 6"></polyline>
            <path d="M19 6l-1 14H6L5 6"></path>
            <path d="M10 11v6M14 11v6"></path>
            <path d="M9 6V4h6v2"></path>
          </svg>
        </div>
        <h3>Baja de bien</h3>
        <p>Dar de baja un bien del inventario patrimonial</p>
        <span class="card-link">Ir a Bajas →</span>
      </a>
    </div>
  </div>

  <hr class="home-divider" />

  <!-- IMÁGENES DEL SISTEMA -->
  <div class="home-section">
    <div class="home-section-hd">
      <h2>Entorno de trabajo: Pantalla de inicio</h2>
      <p>
        Así se ve el Panel de trabajo al ingresar con la extensión activa — clic
        en cada imagen para ampliar
      </p>
    </div>
    <div class="img-grid">
      <div class="img-card" data-aos="fade-up" data-aos-delay="0">
        <a
          href="/Imagenes/1.inicio_parte_arriba_nuevo.png"
          class="glightbox img-card-thumb"
          data-gallery="panel"
          data-title="Parte Superior: Resumen y Pendientes"
          data-description="Muestra el estado de todos los trámites: pendientes, borradores, autorizados y anulados."
        >
          <img
            src="/Imagenes/1.inicio_parte_arriba_nuevo.png"
            alt="Parte Superior del Panel"
            loading="lazy"
          />
          <span class="zoom-badge">🔍 Ampliar</span>
        </a>
        <div class="img-card-body">
          <span class="img-tag top">Parte superior</span>
          <h4>Resumen y pendientes</h4>
          <p>
            Estado de todos los trámites en curso: pendientes, borradores,
            autorizados y anulados.
          </p>
          <p class="img-caption">
            Figura 1: Vista superior del panel de trabajo asistido.
          </p>
        </div>
      </div>

      <div class="img-card" data-aos="fade-up" data-aos-delay="120">
        <a
          href="/Imagenes/2.inicio_parte_operaciones.png"
          class="glightbox img-card-thumb"
          data-gallery="panel"
          data-title="Parte Central: Operaciones Patrimoniales"
          data-description="Tarjetas interactivas para iniciar o buscar cada trámite."
        >
          <img
            src="/Imagenes/2.inicio_parte_operaciones.png"
            alt="Parte Central: Operaciones"
            loading="lazy"
          />
          <span class="zoom-badge">🔍 Ampliar</span>
        </a>
        <div class="img-card-body">
          <span class="img-tag mid">Parte central</span>
          <h4>Operaciones patrimoniales</h4>
          <p>
            Tarjetas interactivas para iniciar o buscar cada trámite: Altas,
            Bajas, Transferencias y Reasignaciones.
          </p>
          <p class="img-caption">
            Figura 2: Panel central con las tarjetas de operaciones principales.
          </p>
        </div>
      </div>

      <div class="img-card" data-aos="fade-up" data-aos-delay="240">
        <a
          href="/Imagenes/3.inicio_parte_abajo_nuevo.png"
          class="glightbox img-card-thumb"
          data-gallery="panel"
          data-title="Parte Inferior: Accesos Frecuentes"
          data-description="Botones de acceso rápido a Reportes y Control Documental."
        >
          <img
            src="/Imagenes/3.inicio_parte_abajo_nuevo.png"
            alt="Parte Inferior: Accesos Frecuentes"
            loading="lazy"
          />
          <span class="zoom-badge">🔍 Ampliar</span>
        </a>
        <div class="img-card-body">
          <span class="img-tag bot">Parte inferior</span>
          <h4>Accesos frecuentes</h4>
          <p>
            Botones de acceso rápido a Reportes patrimoniales y Control
            Documental.
          </p>
          <p class="img-caption">
            Figura 3: Panel inferior con los accesos frecuentes.
          </p>
        </div>
      </div>
    </div>
  </div>

  <hr class="home-divider" />

  <!-- RECURSOS -->
  <div class="home-section">
    <div class="home-section-hd">
      <h2>Recursos y accesos rápidos</h2>
      <p>Descargas y links externos para tu gestión diaria</p>
    </div>
    <div class="rec-grid">
      {
        recursos.extension.visible && (
          <a
            href="https://dga.unsa.edu.ar/docvs/patrimonio/intranet/centro_diaguita/#extension"
            class="rec-card"
            data-aos="fade-up"
            data-aos-delay="0"
          >
            <div class="rec-icon purple">🔌</div>
            <div class="rec-body">
              <strong>Nueva versión de la extensión</strong>
              <span>
                Versión más reciente de la extensión de navegador para SIU
                Diaguita
              </span>
              <span class={`rec-badge ${recursos.extension.badge}`}>
                ⬇ {recursos.extension.label}
              </span>
            </div>
          </a>
        )
      }
      {
        recursos.diaguita.visible && (
          <a
            href="http://diaguitadev.unsa.edu.ar/diaguita/"
            target="_blank"
            class="rec-card"
            data-aos="fade-up"
            data-aos-delay="100"
          >
            <div class="rec-icon navy">🏛️</div>
            <div class="rec-body">
              <strong>Sistema SIU Diaguita Desarrollo</strong>
              <span>
                Acceso directo al sistema de gestión patrimonial de la UNSa
              </span>
              <span class={`rec-badge ${recursos.diaguita.badge}`}>
                ↗ {recursos.diaguita.label}
              </span>
            </div>
          </a>
        )
      }
      {
        recursos.diaguita.visible && (
          <a
            href="http://diaguita.unsa.edu.ar/diaguita/"
            target="_blank"
            class="rec-card"
            data-aos="fade-up"
            data-aos-delay="100"
          >
            <div class="rec-icon navy">🏛️</div>
            <div class="rec-body">
              <strong>Sistema SIU Diaguita Producción</strong>
              <span>
                Acceso directo al sistema de gestión patrimonial de la UNSa
              </span>
              <span class={`rec-badge ${recursos.diaguita.badge}`}>
                ↗ {recursos.diaguita.label}
              </span>
            </div>
          </a>
        )
      }
      {
        recursos.intranet.visible && (
          <a
            href="https://dga.unsa.edu.ar/docvs/patrimonio/intranet/index.php"
            target="_blank"
            class="rec-card"
            data-aos="fade-up"
            data-aos-delay="200"
          >
            <div class="rec-icon green">🔐</div>
            <div class="rec-body">
              <strong>Intranet Patrimonio</strong>
              <span>
                Portal interno de la Dirección — requiere sesión institucional
              </span>
              <span class={`rec-badge ${recursos.intranet.badge}`}>
                ↗ {recursos.intranet.label}
              </span>
            </div>
          </a>
        )
      }
    </div>
  </div>

  <hr class="home-divider" />

  <!-- CONSIDERACIONES -->
  <div class="home-section">
    <div class="home-section-hd">
      <h2>Consideraciones antes de operar</h2>
      <p>Puntos clave que aplican a todas las operaciones del sistema</p>
    </div>
    <div class="consid-grid">
      <div class="consid-card" data-aos="fade-up" data-aos-delay="0">
        <h3>
          <svg
            width="15"
            height="15"
            fill="none"
            stroke="var(--primary)"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          Entorno de trabajo
        </h3>
        <ul>
          <li>
            Usar <strong>Producción</strong> para operaciones reales y definitivas
          </li>
          <li>
            Usar <strong>Desarrollo</strong> solo para prácticas o simulaciones
          </li>
          <li>Verificar que la extensión esté activa antes de iniciar</li>
          <li>Confirmar el entorno en la barra de la extensión</li>
        </ul>
      </div>
      <div class="consid-card" data-aos="fade-up" data-aos-delay="100">
        <h3>
          <svg
            width="15"
            height="15"
            fill="none"
            stroke="var(--primary)"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
            ></path>
            <polyline points="14 2 14 8 20 8"></polyline>
          </svg>
          Documentación necesaria
        </h3>
        <ul>
          <li>Expediente o actuación administrativa correspondiente</li>
          <li>Orden de compra cuando corresponda</li>
          <li>Factura u otro comprobante de respaldo</li>
          <li>Acto administrativo si lo hubiera</li>
          <li>Antecedentes de recepción del bien</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- FOOTER -->
  <footer class="home-footer">
    <div class="footer-top">
      <div class="footer-brand">
        <img
          class="footer-brand-logo"
          src="/Imagenes/0.logo-unsa.png"
          alt="Logo UNSa"
        />
        <h3>Dirección de Patrimonio</h3>
        <p>
          Universidad Nacional de Salta · Dirección General de Administración
        </p>
        <!-- <div class="footer-social">
          <a href="#" class="social-btn" title="Facebook">
            <svg fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
              ></path></svg
            >
          </a>
          <a href="#" class="social-btn" title="Instagram">
            <svg
              fill="none"
              stroke="currentColor"
              stroke-width="2"
